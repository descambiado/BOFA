# BOFA v2.9.2 - Environment Variables Template
# Copy this file to .env and fill in your values

# Application Configuration
VITE_APP_NAME=BOFA
VITE_APP_VERSION=2.9.2
VITE_API_URL=http://localhost:8000
NODE_ENV=development

# Database Configuration
DATABASE_URL=sqlite:///./data/bofa.db
POSTGRES_DB=bofa_db
POSTGRES_USER=bofa
# Required only when enabling the optional database profile.
POSTGRES_PASSWORD=

# Redis Configuration
REDIS_URL=redis://localhost:6379
# Required only when enabling the optional cache profile.
REDIS_PASSWORD=

# JWT and Security
# Leave JWT_SECRET empty to generate and persist a local secret in data/jwt_secret.
JWT_SECRET=
ENCRYPTION_KEY=
SESSION_SECRET=

# Monitoring (optional)
GRAFANA_ADMIN_PASSWORD=

# Labs (optional)
QUANTUM_LAB_DB_PASSWORD=
QUANTUM_SIMULATOR_TOKEN=
POST_QUANTUM_LAB_TOKEN=
QUANTUM_ML_TOKEN=

# External API Keys (Optional)
SHODAN_API_KEY=your_shodan_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
HIBP_API_KEY=your_haveibeenpwned_api_key_here
GITHUB_TOKEN=your_github_token_here

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/var/log/bofa/app.log
