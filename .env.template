# BOFA v3.0.0-alpha.1 - Environment Variables Template
# Copy this file to .env and fill in your values

# Application Configuration
VITE_APP_NAME=BOFA
VITE_APP_VERSION=3.0.0-alpha.1
VITE_API_URL=http://localhost:8000
NODE_ENV=development

# Database Configuration
DATABASE_URL=sqlite:///./data/bofa.db
POSTGRES_DB=bofa_db
POSTGRES_USER=bofa
# Required only when enabling the optional database profile.
POSTGRES_PASSWORD=

# Redis Configuration
REDIS_URL=redis://localhost:6379
# Required only when enabling the optional cache profile.
REDIS_PASSWORD=

# JWT and Security
# Leave JWT_SECRET empty to generate and persist a local secret in data/jwt_secret.
JWT_SECRET=
ENCRYPTION_KEY=
SESSION_SECRET=

# Monitoring (optional)
GRAFANA_ADMIN_PASSWORD=

# Labs (optional)
QUANTUM_LAB_DB_PASSWORD=
QUANTUM_SIMULATOR_TOKEN=
POST_QUANTUM_LAB_TOKEN=
QUANTUM_ML_TOKEN=

# External API Keys (Optional)
SHODAN_API_KEY=your_shodan_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
HIBP_API_KEY=your_haveibeenpwned_api_key_here
GITHUB_TOKEN=your_github_token_here

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/var/log/bofa/app.log

# Local-first AI
BOFA_LLM_PROVIDER=ollama
BOFA_OLLAMA_URL=http://127.0.0.1:11434
BOFA_OLLAMA_MODEL=llama3.2
BOFA_OPENAI_COMPATIBLE_URL=http://127.0.0.1:1234/v1
BOFA_OPENAI_COMPATIBLE_MODEL=local-model
BOFA_OPENAI_COMPATIBLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Execution Fabric (optional remote profiles)
# A mutable image tag without a sha256 digest is rejected.
BOFA_OCI_WORKER_IMAGE=
BOFA_OCI_WORKER_IMAGE_DIGEST=
BOFA_REMOTE_WORKER_URL=
BOFA_REMOTE_WORKER_IMAGE=
BOFA_REMOTE_WORKER_IMAGE_DIGEST=

# SotyHub service-to-service OIDC receiver (disabled until every pin is approved)
BOFA_SOTYHUB_OIDC_ENABLED=false
BOFA_SOTYHUB_OIDC_AUDIENCE=https://bofa-api.sotyhub.com
BOFA_SOTYHUB_SERVICE_ACCOUNT_EMAIL=
BOFA_SOTYHUB_SERVICE_ACCOUNT_SUBJECT=
BOFA_SOTYHUB_SENDER_PROJECT_ID=sotyhub-staging
BOFA_SOTYHUB_OIDC_MAX_LIFETIME_SECONDS=3600
BOFA_SOTYHUB_OIDC_MAX_CLOCK_SKEW_SECONDS=60
